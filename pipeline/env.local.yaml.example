# ============================================================
# env.local.yaml.example — machine-specific pipeline overrides
# ============================================================
# Copy this file to `env.local.yaml` (same directory as config.yaml)
# and edit only the values that differ on YOUR machine.  Values here are
# merged RECURSIVELY over config.yaml, so you only need to list the keys
# you are overriding.  `env.local.yaml` is git-ignored.
#
# The keys below mirror the machine-specific sections of config.yaml.

# --- Python executables for each conda environment ---
# environments:
#   yolo_python:    /path/to/envs/yoloenv/bin/python3.10
#   sam2_python:    /path/to/envs/SAM2/bin/python3.10
#   paddle_python:  /path/to/envs/paddle/bin/python
#   base_python:    /path/to/envs/SAM2/bin/python3.10

# --- GPU device ---
# runtime:
#   gpu_device: "cuda:0"

# --- Input images ---
# input:
#   image_dir: /path/to/input/images

# --- Model checkpoints (override only the ones that differ) ---
# models:
#   yolo_detection:      /path/to/notebook/runs/detect/train/weights/best.pt
#   label_weight_yolo:   /path/to/label_weight_yolo/runs/detect/train/weights/best.pt
#   weight_digit_yolo:   /path/to/pre_ocr_weight_number/runs/detect/train2/weights/best.pt
#   resnet_axis:         /path/to/resnet_weights/best.pt
#   resnet_code_dir:     /path/to/resnet_model
#   sam2_checkpoint:     /path/to/sam2-main/checkpoints/sam2.1_hiera_large.pt
#   sam2_repo_dir:       /path/to/sam2-main
#   vae_checkpoint:      vae/vae_checkpoint.pt

# --- Output base directory ---
# output:
#   base_dir: /path/to/output/results
